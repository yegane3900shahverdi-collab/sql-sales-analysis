 --04_product_analysis :
SELECT
TOP(10) p.productname , 
ROUND(SUM(o.unitprice * o.qty * (1 - o.discount)), 2) as revenue
FROM Sales.OrderDetails as o 
JOIN Production.Products AS p
    ON o.productid = p.productid
GROUP BY p.productname
ORDER BY revenue DESC;
